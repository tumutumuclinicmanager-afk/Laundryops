{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "Customer entity profile with contact and delivery location",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "phone", "address"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Logistics rider and driver entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "vehicle": { "type": "string" },
        "status": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" }
      },
      "required": ["id", "name", "phone"]
    },
    "ServiceItem": {
      "title": "ServiceItem",
      "description": "Laundry and dry cleaning catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "unit": { "type": "string" },
        "price": { "type": "number" }
      },
      "required": ["id", "name", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "Comprehensive laundry order record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerAddress": { "type": "string" },
        "status": { "type": "string" },
        "pickupDate": { "type": "string" },
        "pickupTimeWindow": { "type": "string" },
        "deliveryDate": { "type": "string" },
        "deliveryTimeWindow": { "type": "string" },
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "amountPaid": { "type": "number" },
        "balanceDue": { "type": "number" },
        "notes": { "type": "string" },
        "proofOfDelivery": { "type": "string" },
        "invoiceSent": { "type": "boolean" },
        "invoiceSentAt": { "type": "string" },
        "emailSent": { "type": "boolean" },
        "emailSentAt": { "type": "string" },
        "emailHistory": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "orderNumber", "customerName", "customerPhone", "total", "status"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Financial transaction and payment receipt record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "reference": { "type": "string" },
        "date": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "orderId", "amount", "method"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback and review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "serviceUsed": { "type": "string" },
        "date": { "type": "string" },
        "verified": { "type": "boolean" }
      },
      "required": ["id", "customerName", "rating", "comment"]
    },
    "NotificationLog": {
      "title": "NotificationLog",
      "description": "Email and SMS dispatch audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "orderNumber": { "type": "string" },
        "type": { "type": "string" },
        "recipient": { "type": "string" },
        "recipientName": { "type": "string" },
        "subject": { "type": "string" },
        "status": { "type": "string" },
        "sentAt": { "type": "string" },
        "previewSnippet": { "type": "string" },
        "error": { "type": "string" }
      },
      "required": ["id", "recipient", "status", "sentAt"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Operations and notification configuration",
      "type": "object",
      "properties": {
        "adminEmail": { "type": "string" },
        "autoSendOrderConfirmation": { "type": "boolean" },
        "autoSendStatusUpdates": { "type": "boolean" },
        "autoSendAdminAlerts": { "type": "boolean" },
        "senderName": { "type": "string" },
        "senderEmail": { "type": "string" },
        "smtpConfigured": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer profiles and contact book"
    },
    "/drivers/{driverId}": {
      "schema": "Driver",
      "description": "Delivery riders and drivers directory"
    },
    "/services/{serviceId}": {
      "schema": "ServiceItem",
      "description": "Laundry services catalog and pricing"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Primary laundry operations orders collection"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Financial records and customer receipts"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Public customer feedback and testimonials"
    },
    "/notification_logs/{logId}": {
      "schema": "NotificationLog",
      "description": "Audit logs of sent customer and admin notification emails"
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Operations configuration and notification preferences"
    }
  }
}
